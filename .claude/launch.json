{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Python HTTP Server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    },
    {
      "name": "Node live-server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["live-server", "--port=8080"],
      "port": 8080
    }
  ]
}
